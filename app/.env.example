# ── データベース（Phase 1）──────────────────────────────
# ローカル開発は docker-compose の Postgres を指す
DATABASE_URL="postgresql://kizuna:kizuna@localhost:5432/kizuna_hp?schema=public"

# ── アプリ ─────────────────────────────────────────────
# 公開HP・プレビューのベースURL
APP_BASE_URL="http://localhost:3000"

# アプリ本体の追加ホスト名（任意）。独自ドメイン公開時、本体ドメインを custom 判定から除外するため。
# 例: サービス独自ドメインを使う場合にそのホスト名。未設定でも localhost/*.vercel.app は本体扱い。
# APP_HOST=""

# ── (B) 独自ドメイン公開: Vercel Domains API ───────────────
# 未設定でも「ドメイン登録＋DNS手順提示」までは動く（実際の紐付け・SSLに必要）。
# VERCEL_API_TOKEN=""             # Vercel のアクセストークン
# VERCEL_PROJECT_ID=""            # このアプリの Vercel プロジェクトID
# VERCEL_TEAM_ID=""               # チーム所有なら（任意）

# 署名付きトークン（マジックリンク／Reply-Toトークン）の署名鍵。本番は必ず十分に長いランダム値へ。
TOKEN_SIGNING_SECRET="change-me-in-production-use-a-long-random-string"

# 管理ダッシュボード(/admin)の Basic 認証（未設定だと /admin は全拒否）。
ADMIN_USER=""
ADMIN_PASSWORD=""

# ── Phase 3: メール送受信（Resend）─────────────────────────
# MAIL_PROVIDER を "resend" にし、APIキーと送信元を設定すると本番送信に切替（未設定なら開発用スタブ＝ログ出力）。
# MAIL_PROVIDER="resend"
# MAIL_API_KEY=""                 # Resend の API Key（re_xxx）
# MAIL_FROM="絆 <noreply@your-domain.example>"   # 認証済みドメインの送信元
# MAIL_REPLY_DOMAIN=""            # Reply-To のドメイン（受信Webhook用。未設定なら APP_BASE_URL のホスト名）
# MAIL_INBOUND_WEBHOOK_SECRET=""  # 受信Webhookの署名検証（Resend/Svix）

# 営業メールの送信者情報（特定電子メール法の表示義務。本番前に実在の会社情報を設定）
# MAIL_SENDER_ORG="合同会社絆"
# MAIL_SENDER_ADDRESS=""
# MAIL_SENDER_CONTACT=""

# ── 成果物B: 画像（アップロード / AI雰囲気画像生成）──────────
# BLOB_READ_WRITE_TOKEN があれば Vercel Blob に保存、無ければローカル public/uploads（開発用）。
# 本番の serverless FS は永続しないため、本番の画像保存には Blob トークンが必須。
# BLOB_READ_WRITE_TOKEN=""
# AI画像生成は GEMINI_API_KEY を使用（人物画像は生成しない＝雰囲気画像のみ）。モデルは既定 imagen-4.0-generate-001。
# IMAGE_MODEL="imagen-4.0-generate-001"

# ── Phase 5-6: 決済（Stripe）───────────────────────────────
# STRIPE_SECRET_KEY と STRIPE_PRICE_SUBSCRIPTION があれば Stripe、無ければ開発用スタブ。
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_SUBSCRIPTION=""    # 月額サブスクの Price ID（price_xxx）
# STRIPE_SUCCESS_URL=""           # 未設定なら APP_BASE_URL/billing/success
# STRIPE_CANCEL_URL=""            # 未設定なら APP_BASE_URL/billing/cancel

# ── Phase 3-4: AI編集 ──────────────────────────────────
# プロバイダ選択（省略時は鍵のある方を自動採用。両方あれば gemini 優先）
# EDIT_PROVIDER="gemini"   # "gemini" | "claude"
#
# Google Gemini（無料枠あり。https://aistudio.google.com/apikey で取得）
# GEMINI_API_KEY=""
# GEMINI_MODEL="gemini-2.5-flash"   # 省略可。既定は gemini-2.5-flash
#
# Anthropic Claude
# ANTHROPIC_API_KEY=""
# ANTHROPIC_MODEL="claude-opus-5"   # 省略可
